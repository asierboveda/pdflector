/target
/vendor
/corpus
/.worktrees/
/.venv/
# TCL benchmark JSON runs (generados por tools/adb-bench.sh)
/bench-results-TCL-*.json

# Ecosystem agent skills (installed via `npx skills add`; reproducible from
# skills-lock.json). Project-authored skills live in .agents/skills/.
/.agents/skills/*
!/.agents/skills/kanvas/
!/.agents/skills/master-sync/
/.claude/skills/

# API keys locales de IA (uso personal, NO commitear). google_key.txt ya no
# se usa (la clave de Gemini se introduce en la app, PR-02); se mantiene
# ignorado por si queda una copia antigua en algún árbol de trabajo.
crates/pdf_android/groq_key.txt
crates/pdf_android/google_key.txt

# Output de build del helper IME (tools/ime/, regenerado con build.sh)
tools/ime/out/

# Logs de herramientas de desarrollo en la raíz del repo (p. ej. snowflake.log
# que escribe Positron al abrir el proyecto): no son parte del producto.
*.log

# Cachés generadas por las herramientas Python.
__pycache__/
*.pyc
